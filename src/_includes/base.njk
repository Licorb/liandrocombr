<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Crimson+Pro:wght@400;600&family=Work+Sans:wght@400;500&display=swap" rel="stylesheet">
    <!-- <link rel="stylesheet" href="/assets/css/estilo.css"> -->
    <style>
        :root {
            --color-bg: #f5f2ed;
            --color-text: #2a2a2a;
            --color-accent: #8b7355;
            --color-border: #e0d9d0;
            --font-serif: 'Crimson Pro', serif;
            --font-sans: 'Work Sans', sans-serif;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: var(--font-sans);
            background: var(--color-bg);
            color: var(--color-text);
            line-height: 1.8;
        }

        /* Header */
        header {
            padding: 2rem 3rem;
            border-bottom: 1px solid var(--color-border);
            background: rgba(245, 242, 237, 0.95);
            backdrop-filter: blur(10px);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        header h1 {
            font-family: var(--font-serif);
            font-size: 1.2rem;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            font-weight: 600;
        }

        /* Breadcrumb */
        .breadcrumb {
            font-size: 0.9rem;
            color: #333;
            margin: 2rem 0 0 0;
            font-family: var(--font-sans);
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
            align-items: center;
        }

        .breadcrumb a {
            color: #888;
            text-decoration: none;
            transition: color 0.3s ease;
        }

        .breadcrumb a:hover {
            color: #6b5344;
        }


        .breadcrumb span {
            color: #333;
        }

        /* Hero Image */
        .post-hero {
            width: 100%;
            max-width: 100%;
            height: 360px;
            margin: 2rem 0;
            border-radius: 6px;
            display: block;
            object-fit: cover;
        }

        /* Main Content */
        main {
            width: 100%;
        }

        .post-container {
            max-width: 900px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        /* Post Title */
        .post-title {
            font-family: var(--font-serif);
            font-size: 3.5rem;
            line-height: 1.1;
            margin: 3rem 0 1rem;
            font-weight: 600;
            color: var(--color-text);
        }

        /* Post Metadata */
        .post-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin: 1rem 0 0;
            padding: 0 0 3rem 0;
            border-bottom: 1px solid var(--color-border);
        }

        .post-date {
            font-family: var(--font-sans);
            font-size: 0.9rem;
            color: #888;
            letter-spacing: 0.05em;
        }

        .post-tags {
            display: flex;
            gap: 0.8rem;
            flex-wrap: wrap;
            justify-content: flex-end;
        }

        .post-tag {
            background: var(--color-accent);
            color: #fff;
            padding: 0.3rem 0.8rem;
            font-size: 0.75rem;
            border-radius: 3px;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            font-weight: 500;
        }

        /* Post Content */
        .post-content {
            font-family: var(--font-serif);
            font-size: 1.3rem;
            line-height: 1.9;
            margin-bottom: 6rem;
        }

        .post-content p {
            margin-bottom: 2.5rem;
        }

        .post-content h2 {
            font-size: 2.2rem;
            margin: 4rem 0 2rem;
            font-weight: 600;
        }

        .post-content h3 {
            font-size: 1.8rem;
            margin: 3rem 0 1.5rem;
            font-weight: 600;
        }

        .post-content ul,
        .post-content ol {
            margin: 2rem 0 2rem 2rem;
        }

        .post-content li {
            margin-bottom: 1rem;
        }

        .post-content a {
            color: var(--color-accent);
            text-decoration: none;
            border-bottom: 1px solid var(--color-accent);
            transition: color 0.3s ease;
        }

        .post-content a:hover {
            color: #6b5344;
        }

        .post-content blockquote {
            border-left: 4px solid var(--color-accent);
            padding-left: 2rem;
            margin: 3rem 0;
            font-style: italic;
            color: #666;
        }

        .post-content code {
            background: rgba(0,0,0,0.05);
            padding: 0.2rem 0.5rem;
            border-radius: 3px;
            font-family: 'Courier New', monospace;
            font-size: 0.9em;
        }

        .post-content pre {
            background: rgba(0,0,0,0.05);
            padding: 1.5rem;
            border-radius: 6px;
            overflow-x: auto;
            margin: 2rem 0;
        }

        .post-content pre code {
            background: transparent;
            padding: 0;
        }

        .post-content img {
            width: 100%;
            height: auto;
            margin: 3rem 0;
            border-radius: 6px;
        }

        /* ===== ÚLTIMOS FICHAMENTOS - SEÇÃO ATUALIZADA ===== */
        .fichamentos-section {
            max-width: 1200px;
            margin: 6rem auto;
            padding: 0 2rem;
        }

        .fichamentos-header {
            text-align: center;
            margin-bottom: 4rem;
        }

        .fichamentos-header h2 {
            font-family: var(--font-serif);
            font-size: 2.8rem;
            font-weight: 600;
            color: var(--color-text);
            margin-bottom: 0.5rem;
        }

        .fichamentos-header p {
            font-size: 1rem;
            color: #888;
            letter-spacing: 0.05em;
        }

        .fichamentos-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 2.5rem;
            list-style: none;
        }

        .fichamento-card {
            background: #fff;
            border: 1px solid var(--color-border);
            border-radius: 6px;
            overflow: hidden;
            transition: all 0.3s ease;
            display: flex;
            flex-direction: column;
        }

        .fichamento-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.1);
            border-color: var(--color-accent);
        }

        .fichamento-thumbnail {
            width: 100%;
            height: 240px;
            object-fit: cover;
            display: block;
        }

        .fichamento-content {
            padding: 1.8rem;
            display: flex;
            flex-direction: column;
            gap: 1rem;
            flex-grow: 1;
        }

        .fichamento-date {
            font-size: 0.8rem;
            color: #999;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            font-weight: 500;
        }

        .fichamento-title {
            font-family: var(--font-serif);
            font-size: 1.5rem;
            line-height: 1.3;
            margin: 0;
            font-weight: 600;
        }

        .fichamento-title a {
            color: var(--color-text);
            text-decoration: none;
            transition: color 0.3s ease;
        }

        .fichamento-title a:hover {
            color: var(--color-accent);
        }

        .fichamento-excerpt {
            font-size: 0.95rem;
            color: #666;
            line-height: 1.6;
            margin-top: auto;
        }

        /* Responsive - Fichamentos */
        @media (max-width: 1024px) {
            .fichamentos-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 2rem;
            }
        }

        @media (max-width: 768px) {
            .fichamentos-section {
                margin: 4rem auto;
            }

            .fichamentos-header h2 {
                font-size: 2.2rem;
            }

            .fichamentos-grid {
                grid-template-columns: 1fr;
                gap: 2rem;
            }

            .fichamento-thumbnail {
                height: 200px;
            }
        }

        /* Footer */
        footer {
            background: rgba(0,0,0,0.05);
            padding: 4rem 2rem;
            margin-top: 6rem;
            text-align: center;
            border-top: 1px solid var(--color-border);
        }

        footer p {
            font-size: 0.9rem;
            color: #888;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .breadcrumb {
                font-size: 0.85rem;
                padding: 1rem 1.5rem 0;
            }

            .post-title {
                font-size: 2.5rem;
                margin: 4rem 0 2rem;
            }

            .post-meta {
                flex-direction: column;
                align-items: flex-start;
                gap: 1.5rem;
                padding-bottom: 2rem;
            }

            .post-tags {
                justify-content: flex-start;
            }

            .post-content {
                font-size: 1.1rem;
            }

            .post-hero {
                height: 40vh;
            }

            .post-container {
                padding: 0 1.5rem;
            }
        }

        @media (max-width: 480px) {
            header {
                padding: 1.5rem 1rem;
            }

            header h1 {
                font-size: 1rem;
            }

            .post-title {
                font-size: 2rem;
                margin: 3rem 0 1.5rem;
            }

            .post-content {
                font-size: 1rem;
            }

            .post-hero {
                height: 35vh;
            }

            .fichamentos-content {
                padding: 1.5rem;
            }

            .fichamento-title {
                font-size: 1.3rem;
            }
        }

        .btn {
            display: inline-block;
            padding: 0.9rem 2rem;
            text-decoration: none;
            font-weight: 500;
            font-size: 0.9rem;
            letter-spacing: 0.05em;
            transition: all 0.3s ease;
            border: 1px solid var(--color-border);
        }

        .btn-secondary {
            background: transparent;
            color: var(--color-text);
        }

        .btn-secondary:hover {
            background: var(--color-text);
            color: white;
        }


    </style>
</head>
<body>
    <header>
        <h1>{{ site.title | default('Meu Blog') }}</h1>
    </header>


    <main>
        <article class="post-container">
            {% if image %}
            <img src="{{ image }}" alt="{{ title }}" class="post-hero">
            {% endif %}

            <nav aria-label="Breadcrumb" class="breadcrumb">
                <ul style="display: flex; list-style: none; padding: 0; gap: 8px;">
                    <li><a href="/">Home</a></li>
                    
                    {# Divide a URL e remove partes vazias #}
                    {% set segments = page.url.split('/') %}
                    
                    {% set currentPath = "" %}
                    {% for segment in segments %}
                    {% if segment != "" %}
                        {% set currentPath = currentPath + "/" + segment + "/" %}
                        <li>
                        <span style="margin:0 4px; color: #999;">|</span>
                        {% if loop.last %}
                            {# Na última parte, usamos o título da página #}
                            <strong>{{ title }}</strong>
                        {% else %}
                            {# Nas partes do meio, limpamos o nome da pasta #}
                            <a href="{{ currentPath }}">{{ segment | replace("-", " ") | capitalize }}</a>
                        {% endif %}
                        </li>
                    {% endif %}
                    {% endfor %}
                </ul>
            </nav>

            <h1 class="post-title">{{ title }}</h1>

            <div class="post-meta">
                <time class="post-date" datetime="{{ date | dateIso }}">
                    {{ date | dateFilter }}
                </time>
                {% if tags and tags | length > 0 %}
                <div class="post-tags">
                    {% for tag in tags %}
                        {% if tag !== 'posts' %}
                        <span class="post-tag">{{ tag }}</span>
                        {% endif %}
                    {% endfor %}
                </div>
                {% endif %}
            </div>

            <div class="post-content">
                {{ content | safe }}
            </div>
        </article>

        {# ===== SEÇÃO DE ÚLTIMOS FICHAMENTOS - ATUALIZADA ===== #}
        <section class="fichamentos-section">
            <div class="fichamentos-header">
                <h2>Últimos Fichamentos</h2>
                <p>Reflexões recentes sobre leituras e referências</p>
            </div>

            <ul class="fichamentos-grid">
                {% for post in collections.posts | reverse %}
                {% if loop.index0 < 3 %}

                <li class="fichamento-card">
                    <a href="{{ post.url }}">
                        {% if post.data.image %}
                        <img src="{{ post.data.image }}" alt="{{ post.data.title }}" class="fichamento-thumbnail">
                        {% else %}
                        <img src="/assets/images/placeholder.jpg" alt="{{ post.data.title }}" class="fichamento-thumbnail">
                        {% endif %}
                    </a>
                    
                    <div class="fichamento-content">
                        <time class="fichamento-date" datetime="{{ post.date | dateIso }}">
                            {{ post.date | dateFilter }}
                        </time>
                        
                        <h3 class="fichamento-title">
                            <a href="{{ post.url }}">{{ post.data.title }}</a>
                        </h3>
                        
                        {% if post.data.description %}
                        <p class="fichamento-excerpt">{{ post.data.description }}</p>
                        {% endif %}
                    </div>
                </li>
                {% endif %}
                {% endfor %}
            </ul>

            {% set segments = page.url.split('/') %}
            {# Remove o último segmento vazio e o nome do post #}
            {% set parentPath = "" %}

            <div class="voltar-container" style="margin: 20px 0;">
            <a href=".." class="btn btn-secondary">
                &larr; Voltar para listagem
            </a>
            </div>
        </section>
    </main>

    <footer>
        <p>&copy; 2026 {{ site.author | default('Seu Nome') }}. Todos os direitos reservados.</p>
    </footer>
</body>
</html>
