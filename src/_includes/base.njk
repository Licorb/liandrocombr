<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Crimson+Pro:wght@400;600&family=Work+Sans:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/assets/css/estilo.css">
    <link rel="stylesheet" href="/assets/css/estilo-njk.css">
</head>
<body class="base-default">
    <nav>
        <div class="nav-brand">
            {% if title %}
                {{ title }} de Liandro
            {% else %}
                Liandro Ribeiro
            {% endif %}
        </div>
        <ul>
            <li><a href="../../.">Ponto de Partida</a></li>
            <li><a href="../../repertorio">Repertório</a></li>
            <li><a href="../../oficina">Oficina</a></li>
            <li><a href="../../#contato">Contato</a></li>
        </ul>
    </nav>

    <main>
        <article class="post-container">
            <div aria-label="Breadcrumb" class="breadcrumb">
                <ul style="display: flex; list-style: none; padding: 0; gap: 8px;">
                    <li><a href="/">Home</a></li>
                    
                    {# Divide a URL e remove partes vazias #}
                    {% set segments = page.url.split('/') %}
                    
                    {% set currentPath = "" %}
                    {% for segment in segments %}
                    {% if segment != "" %}
                        {% set currentPath = currentPath + "/" + segment + "/" %}
                        <li>
                        <span style="margin:0 4px; color: #999;">|</span>
                        {% if loop.last %}
                            {# Na última parte, usamos o título da página #}
                            <strong>{{ title }}</strong>
                        {% else %}
                            {# Nas partes do meio, limpamos o nome da pasta #}
                            <a href="{{ currentPath }}">{{ segment | replace("-", " ") | capitalize }}</a>
                        {% endif %}
                        </li>
                    {% endif %}
                    {% endfor %}
                </ul>
            </div>
            {% if image %}
            <img src="{{ image }}" alt="{{ title }}" class="post-hero">
            {% endif %}

            

            <h1 class="post-title">{{ title }}</h1>

            <div class="post-meta">
                <time class="post-date" datetime="{{ date | dateIso }}">
                    {{ date | dateFilter }}
                </time>
                {% if tags and tags | length > 0 %}
                <div class="post-tags">
                    {% for tag in tags %}
                        {% if tag !== 'posts' %}
                        <span class="post-tag">{{ tag }}</span>
                        {% endif %}
                    {% endfor %}
                </div>
                {% endif %}
            </div>

            <div class="post-content">
                {{ content | safe }}
            </div>
        </article>

        {# ===== SEÇÃO DE ÚLTIMOS FICHAMENTOS - ATUALIZADA ===== #}
        {% block relacionados %}
        <section class="fichamentos-section">
            <div class="fichamentos-header">
                <h2>Últimos Fichamentos</h2>
                <p>Reflexões recentes sobre leituras e referências</p>
            </div>

            <ul class="fichamentos-grid">
                {% for post in collections.posts | reverse %}
                {% if loop.index0 < 3 %}

                <li class="fichamento-card">
                    <a href="{{ post.url }}">
                        {% if post.data.image %}
                        <img src="{{ post.data.image }}" alt="{{ post.data.title }}" class="fichamento-thumbnail">
                        {% else %}
                        <img src="/assets/images/placeholder.jpg" alt="{{ post.data.title }}" class="fichamento-thumbnail">
                        {% endif %}
                    </a>
                    
                    <div class="fichamento-content">
                        <time class="fichamento-date" datetime="{{ post.date | dateIso }}">
                            {{ post.date | dateFilter }}
                        </time>
                        
                        <h3 class="fichamento-title">
                            <a href="{{ post.url }}">{{ post.data.title }}</a>
                        </h3>
                        
                        {% if post.data.description %}
                        <p class="fichamento-excerpt">{{ post.data.description }}</p>
                        {% endif %}
                    </div>
                </li>
                {% endif %}
                {% endfor %}
            </ul>

            {% set segments = page.url.split('/') %}
            {# Remove o último segmento vazio e o nome do post #}
            {% set parentPath = "" %}

            <div class="voltar-container" style="margin: 20px 0;">
            <a href=".." class="btn btn-secondary">
                &larr; Voltar para listagem
            </a>
            </div>
        </section>
        {% endblock %}
    </main>

    <footer>
        <p>&copy; 2026 {{ site.author | default('Seu Nome') }}. Todos os direitos reservados.</p>
    </footer>
</body>
</html>
