<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Crimson+Pro:wght@400;600&family=Work+Sans:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/assets/css/estilo.css">
    <link rel="stylesheet" href="/assets/css/estilo-njk.css">
</head>
<body class="base-default">
    <nav>
        <div class="nav-brand">
            {% if title %}
                {{ title }} de Liandro
            {% else %}
                Liandro Ribeiro
            {% endif %}
        </div>
        <ul>
            <li><a href="../../.">Ponto de Partida</a></li>
            <li><a href="../../repertorio">Repertório</a></li>
            <li><a href="../../oficina">Oficina</a></li>
            <li><a href="../../#contato">Contato</a></li>
        </ul>
    </nav>

    <main>
        <article class="post-container">
            <div aria-label="Breadcrumb" class="breadcrumb">
                <ul style="display: flex; list-style: none; padding: 0; gap: 8px;">
                    <li><a href="/">Home</a></li>
                    
                    {# Divide a URL e remove partes vazias #}
                    {% set segments = page.url.split('/') %}
                    
                    {% set currentPath = "" %}
                    {% for segment in segments %}
                    {% if segment != "" %}
                        {% set currentPath = currentPath + "/" + segment + "/" %}
                        <li>
                        <span style="margin:0 4px; color: #999;">|</span>
                        {% if loop.last %}
                            {# Na última parte, usamos o título da página #}
                            <strong>{{ title }}</strong>
                        {% else %}
                            {# Nas partes do meio, limpamos o nome da pasta #}
                            <a href="{{ currentPath }}">{{ segment | replace("-", " ") | capitalize }}</a>
                        {% endif %}
                        </li>
                    {% endif %}
                    {% endfor %}
                </ul>
            </div>
            {% if image %}
            <img src="{{ image }}" alt="{{ title }}" class="post-hero">
            {% endif %}

            

            <h1 class="post-title">{{ title }}</h1>

            <div class="post-meta">
                <time class="post-date" datetime="{{ date | dateIso }}">
                    {{ date | dateFilter }}
                </time>
                {% if tags and tags | length > 0 %}
                <div class="post-tags">
                    {% for tag in tags %}
                        {% if tag !== 'posts' %}
                        <span class="post-tag">{{ tag }}</span>
                        {% endif %}
                    {% endfor %}
                </div>
                {% endif %}
            </div>

            <div class="post-content">
                {{ content | safe }}
            </div>
        </article>

        {# ===== SEÇÃO DE TRABALHOS RELACIONADOS ===== #}
        {% block relacionados %}
        {% if relatedWorks %}
        <section class="related-works-section">
            <div class="related-works-header">
                <h2>Posts Relacionados</h2>
                <p>Mais referências e projetos relacionados</p>
            </div>

            <ul class="related-works-grid">
                {% for work in relatedWorks %}
                <li>
                    <a href="{{ work.url }}" class="related-work-card">
                        {% if work.image %}
                        <img src="{{ work.image }}" alt="{{ work.title }}" class="related-work-thumbnail">
                        {% else %}
                        <img src="/assets/images/placeholder.jpg" alt="{{ work.title }}" class="related-work-thumbnail">
                        {% endif %}
                        
                        <div class="related-work-content">
                            {% if work.date %}
                            <time class="related-work-date" datetime="{{ work.date | dateIso }}">
                                {{ work.date | dateFilter }}
                            </time>
                            {% endif %}
                            
                            <h3 class="related-work-title">
                                {{ work.title }}
                            </h3>
                            
                            {% if work.description %}
                            <p class="related-work-excerpt">{{ work.description }}</p>
                            {% endif %}
                        </div>
                    </a>
                </li>
                {% endfor %}
            </ul>
            <div class="voltar-container" style="margin: 20px 0; padding: 0 2rem;">
                <a href=".." class="btn btn-secondary">
                    &larr; Voltar para listagem
                </a>
            </div>
        </section>
        {% endif %}
        {% endblock %}
    </main>

    <footer>
        <p>&copy; 2026 {{ site.author | default('Seu Nome') }}. Todos os direitos reservados.</p>
    </footer>
</body>
</html>
