<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Crimson+Pro:wght@400;600&family=Work+Sans:wght@400;500&display=swap" rel="stylesheet">
    <!-- <link rel="stylesheet" href="/assets/css/estilo.css"> -->
    <style>
        :root {
            --color-bg: #f5f2ed;
            --color-text: #2a2a2a;
            --color-accent: #8b7355;
            --color-border: #e0d9d0;
            --font-serif: 'Crimson Pro', serif;
            --font-sans: 'Work Sans', sans-serif;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: var(--font-sans);
            background: var(--color-bg);
            color: var(--color-text);
            line-height: 1.8;
        }

        /* Header */
        header {
            padding: 2rem 3rem;
            border-bottom: 1px solid var(--color-border);
            background: rgba(245, 242, 237, 0.95);
            backdrop-filter: blur(10px);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        header h1 {
            font-family: var(--font-serif);
            font-size: 1.2rem;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            font-weight: 600;
        }

        /* Breadcrumb */
        .breadcrumb {
            font-size: 0.9rem;
            color: #333;
            margin: 2rem 0 0 0;
            font-family: var(--font-sans);
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
            align-items: center;
        }

        .breadcrumb a {
            color: #888;
            text-decoration: none;
            transition: color 0.3s ease;
        }

        .breadcrumb a:hover {
            color: #6b5344;
        }


        .breadcrumb span {
            color: #333;
        }

        /* ===== SLIDER LAYOUT ===== */
        .slider-container {
            width: 100%;
            margin: 2rem 0 0;
            position: relative;
        }

        .slider-main {
            width: 100%;
            height: 50vh;
            position: relative;
            overflow: hidden;
            background: #000;
        }

        .slider-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            opacity: 0;
            transition: opacity 0.4s ease-in-out;
        }

        .slider-image.active {
            opacity: 1;
        }

        .slider-controls {
            position: absolute;
            top: 50%;
            left: 0;
            right: 0;
            display: flex;
            justify-content: space-between;
            padding: 0 2rem;
            transform: translateY(-50%);
            pointer-events: none;
            z-index: 10;
        }

        .slider-arrow {
            width: 50px;
            height: 50px;
            background: rgba(255, 255, 255, 0.7);
            border: none;
            border-radius: 50%;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            color: #2a2a2a;
            transition: all 0.3s ease;
            pointer-events: all;
        }

        .slider-arrow:hover {
            background: rgba(255, 255, 255, 1);
            transform: scale(1.1);
        }

        .slider-gallery {
            display: flex;
            gap: 1rem;
            padding: 2rem;
            background: var(--color-bg);
            overflow-x: auto;
            justify-content: center;
            flex-wrap: wrap;
        }

        .gallery-thumbnail {
            width: 120px;
            height: 120px;
            border: 3px solid transparent;
            border-radius: 4px;
            cursor: pointer;
            overflow: hidden;
            flex-shrink: 0;
            transition: all 0.3s ease;
        }

        .gallery-thumbnail img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .gallery-thumbnail:hover {
            border-color: var(--color-accent);
            transform: scale(1.05);
        }

        .gallery-thumbnail.active {
            border-color: var(--color-accent);
            box-shadow: 0 4px 12px rgba(139, 115, 85, 0.3);
        }

        .slider-indicators {
            display: flex;
            justify-content: center;
            gap: 0.5rem;
            padding: 1.5rem 0;
            background: var(--color-bg);
        }

        .indicator {
            width: 10px;
            height: 2px;
            background: #ccc;
            border: none;
            cursor: pointer;
            border-radius: 1px;
            transition: all 0.3s ease;
        }

        .indicator.active {
            background: var(--color-accent);
            width: 30px;
        }

        /* Hero Image */
        .post-hero {
            width: 100%;
            max-width: 100%;
            height: 360px;
            margin: 2rem 0;
            border-radius: 6px;
            display: block;
            object-fit: cover;
        }

        /* Main Content */
        main {
            width: 100%;
        }

        .post-container {
            max-width: 900px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        /* Post Title */
        .post-title {
            font-family: var(--font-serif);
            font-size: 3.5rem;
            line-height: 1.1;
            margin: 3rem 0 1rem;
            font-weight: 600;
            color: var(--color-text);
        }

        /* Post Metadata */
        .post-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin: 1rem 0 0;
            padding: 0 0 3rem 0;
            border-bottom: 1px solid var(--color-border);
        }

        .post-date {
            font-family: var(--font-sans);
            font-size: 0.9rem;
            color: #888;
            letter-spacing: 0.05em;
        }

        .post-tags {
            display: flex;
            gap: 0.8rem;
            flex-wrap: wrap;
            justify-content: flex-end;
        }

        .post-tag {
            background: var(--color-accent);
            color: #fff;
            padding: 0.3rem 0.8rem;
            font-size: 0.75rem;
            border-radius: 3px;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            font-weight: 500;
        }

        /* Post Content */
        .post-content {
            font-family: var(--font-serif);
            font-size: 1.3rem;
            line-height: 1.9;
            margin-bottom: 6rem;
        }

        .post-content p {
            margin-bottom: 2.5rem;
        }

        .post-content h2 {
            font-size: 2.2rem;
            margin: 4rem 0 2rem;
            font-weight: 600;
        }

        .post-content h3 {
            font-size: 1.8rem;
            margin: 3rem 0 1.5rem;
            font-weight: 600;
        }

        .post-content ul,
        .post-content ol {
            margin: 2rem 0 2rem 2rem;
        }

        .post-content li {
            margin-bottom: 1rem;
        }

        .post-content a {
            color: var(--color-accent);
            text-decoration: none;
            border-bottom: 1px solid var(--color-accent);
            transition: color 0.3s ease;
        }

        .post-content a:hover {
            color: #6b5344;
        }

        .post-content blockquote {
            border-left: 4px solid var(--color-accent);
            padding-left: 2rem;
            margin: 3rem 0;
            font-style: italic;
            color: #666;
        }

        .post-content code {
            background: rgba(0,0,0,0.05);
            padding: 0.2rem 0.5rem;
            border-radius: 3px;
            font-family: 'Courier New', monospace;
            font-size: 0.9em;
        }

        .post-content pre {
            background: rgba(0,0,0,0.05);
            padding: 1.5rem;
            border-radius: 6px;
            overflow-x: auto;
            margin: 2rem 0;
        }

        .post-content pre code {
            background: transparent;
            padding: 0;
        }

        .post-content img {
            width: 100%;
            height: auto;
            margin: 3rem 0;
            border-radius: 6px;
        }

        /* ===== OUTROS TRABALHOS - SEÇÃO ATUALIZADA ===== */
        .trabalhos-section {
            max-width: 1200px;
            margin: 6rem auto;
            padding: 0 2rem;
        }

        .trabalhos-header {
            text-align: center;
            margin-bottom: 4rem;
        }

        .trabalhos-header h2 {
            font-family: var(--font-serif);
            font-size: 2.8rem;
            font-weight: 600;
            color: var(--color-text);
            margin-bottom: 0.5rem;
        }

        .trabalhos-header p {
            font-size: 1rem;
            color: #888;
            letter-spacing: 0.05em;
        }

        .trabalhos-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 2.5rem;
            list-style: none;
        }

        .trabalho-card {
            background: #fff;
            border: 1px solid var(--color-border);
            border-radius: 6px;
            overflow: hidden;
            transition: all 0.3s ease;
            display: flex;
            flex-direction: column;
        }

        .trabalho-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.1);
            border-color: var(--color-accent);
        }

        .trabalho-thumbnail {
            width: 100%;
            height: 240px;
            object-fit: cover;
            display: block;
        }

        .trabalho-content {
            padding: 1.8rem;
            display: flex;
            flex-direction: column;
            gap: 1rem;
            flex-grow: 1;
        }

        .trabalho-date {
            font-size: 0.8rem;
            color: #999;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            font-weight: 500;
        }

        .trabalho-title {
            font-family: var(--font-serif);
            font-size: 1.5rem;
            line-height: 1.3;
            margin: 0;
            font-weight: 600;
        }

        .trabalho-title a {
            color: var(--color-text);
            text-decoration: none;
            transition: color 0.3s ease;
        }

        .trabalho-title a:hover {
            color: var(--color-accent);
        }

        .trabalho-excerpt {
            font-size: 0.95rem;
            color: #666;
            line-height: 1.6;
            margin-top: auto;
        }

        /* Responsive - Trabalhos */
        @media (max-width: 1024px) {
            .trabalhos-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 2rem;
            }
        }

        @media (max-width: 768px) {
            .trabalhos-section {
                margin: 4rem auto;
            }

            .trabalhos-header h2 {
                font-size: 2.2rem;
            }

            .trabalhos-grid {
                grid-template-columns: 1fr;
                gap: 2rem;
            }

            .trabalho-thumbnail {
                height: 200px;
            }

            .slider-arrow {
                width: 40px;
                height: 40px;
                font-size: 1.2rem;
            }

            .slider-controls {
                padding: 0 1rem;
            }

            .gallery-thumbnail {
                width: 100px;
                height: 100px;
            }
        }

        /* Footer */
        footer {
            background: rgba(0,0,0,0.05);
            padding: 4rem 2rem;
            margin-top: 6rem;
            text-align: center;
            border-top: 1px solid var(--color-border);
        }

        footer p {
            font-size: 0.9rem;
            color: #888;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .breadcrumb {
                font-size: 0.85rem;
                padding: 1rem 1.5rem 0;
            }

            .post-title {
                font-size: 2.5rem;
                margin: 4rem 0 2rem;
            }

            .post-meta {
                flex-direction: column;
                align-items: flex-start;
                gap: 1.5rem;
                padding-bottom: 2rem;
            }

            .post-tags {
                justify-content: flex-start;
            }

            .post-content {
                font-size: 1.1rem;
            }

            .post-hero {
                height: 40vh;
            }

            .post-container {
                padding: 0 1.5rem;
            }
        }

        @media (max-width: 480px) {
            header {
                padding: 1.5rem 1rem;
            }

            header h1 {
                font-size: 1rem;
            }

            .post-title {
                font-size: 2rem;
                margin: 3rem 0 1.5rem;
            }

            .post-content {
                font-size: 1rem;
            }

            .post-hero {
                height: 35vh;
            }

            .fichamentos-content {
                padding: 1.5rem;
            }

            .fichamento-title {
                font-size: 1.3rem;
            }
        }
    </style>
</head>
<body>
    <header>
        <h1>{{ site.title | default('Meu Blog') }}</h1>
    </header>


    <main>
        <article class="post-container">
            {# ===== SLIDER COM GALERIA ===== #}
            {% if image or collections.posts %}
            <div class="slider-container">
                <div class="slider-main" id="sliderMain">
                    {# Imagem principal (se existir) #}
                    {% if image %}
                    <img src="{{ image }}" alt="{{ title }}" class="slider-image active" data-index="0">
                    {% endif %}
                    
                    {# Imagens dos trabalhos recentes #}
                    {% for post in collections.posts | reverse | limit(3) %}
                    {% if post.data.image %}
                    <img src="{{ post.data.image }}" alt="{{ post.data.title }}" class="slider-image" data-index="{{ loop.index }}">
                    {% endif %}
                    {% endfor %}
                </div>

                {# Controles de navegação #}
                <div class="slider-controls">
                    <button class="slider-arrow" id="prevBtn" aria-label="Imagem anterior">←</button>
                    <button class="slider-arrow" id="nextBtn" aria-label="Próxima imagem">→</button>
                </div>
            </div>

            {# Galeria de thumbnails #}
            <div class="slider-gallery" id="sliderGallery">
                {% if image %}
                <div class="gallery-thumbnail active" data-index="0" title="{{ title }}">
                    <img src="{{ image }}" alt="{{ title }}">
                </div>
                {% endif %}
                
                {% for post in collections.posts | reverse | limit(3) %}
                {% if post.data.image %}
                <div class="gallery-thumbnail" data-index="{{ loop.index }}" title="{{ post.data.title }}">
                    <img src="{{ post.data.image }}" alt="{{ post.data.title }}">
                </div>
                {% endif %}
                {% endfor %}
            </div>

            {# Indicadores #}
            <div class="slider-indicators" id="sliderIndicators">
                {% if image %}
                <button class="indicator active" data-index="0" aria-label="Ir para imagem 1"></button>
                {% endif %}
                {% for post in collections.posts | reverse | limit(3) %}
                {% if post.data.image %}
                <button class="indicator" data-index="{{ loop.index }}" aria-label="Ir para imagem {{ loop.index + 1 }}"></button>
                {% endif %}
                {% endfor %}
            </div>
            {% endif %}

            <nav aria-label="Breadcrumb" class="breadcrumb">
                <ul style="display: flex; list-style: none; padding: 0; gap: 8px;">
                    <li><a href="/">Home</a></li>
                    
                    {# Divide a URL e remove partes vazias #}
                    {% set segments = page.url.split('/') %}
                    
                    {% set currentPath = "" %}
                    {% for segment in segments %}
                    {% if segment != "" %}
                        {% set currentPath = currentPath + "/" + segment + "/" %}
                        <li>
                        <span style="margin:0 4px; color: #999;">|</span>
                        {% if loop.last %}
                            {# Na última parte, usamos o título da página #}
                            <strong>{{ title }}</strong>
                        {% else %}
                            {# Nas partes do meio, limpamos o nome da pasta #}
                            <a href="{{ currentPath }}">{{ segment | replace("-", " ") | capitalize }}</a>
                        {% endif %}
                        </li>
                    {% endif %}
                    {% endfor %}
                </ul>
            </nav>

            <h1 class="post-title">{{ title }}</h1>

            <div class="post-meta">
                <time class="post-date" datetime="{{ date | dateIso }}">
                    {{ date | dateFilter }}
                </time>
                {% if tags and tags | length > 0 %}
                <div class="post-tags">
                    {% for tag in tags %}
                        {% if tag !== 'posts' %}
                        <span class="post-tag">{{ tag }}</span>
                        {% endif %}
                    {% endfor %}
                </div>
                {% endif %}
            </div>

            <div class="post-content">
                {{ content | safe }}
            </div>
        </article>

        {# ===== SEÇÃO DE OUTROS TRABALHOS ===== #}
        <section class="trabalhos-section">
            <div class="trabalhos-header">
                <h2>Outros Trabalhos</h2>
                <p>Mais referências e projetos relacionados</p>
            </div>

            <ul class="trabalhos-grid">
                {% for post in collections.posts | reverse | limit(3) %}
                <li class="trabalho-card">
                    <a href="{{ post.url }}">
                        {% if post.data.image %}
                        <img src="{{ post.data.image }}" alt="{{ post.data.title }}" class="trabalho-thumbnail">
                        {% else %}
                        <img src="/assets/images/placeholder.jpg" alt="{{ post.data.title }}" class="trabalho-thumbnail">
                        {% endif %}
                    </a>
                    
                    <div class="trabalho-content">
                        <time class="trabalho-date" datetime="{{ post.date | dateIso }}">
                            {{ post.date | dateFilter }}
                        </time>
                        
                        <h3 class="trabalho-title">
                            <a href="{{ post.url }}">{{ post.data.title }}</a>
                        </h3>
                        
                        {% if post.data.description %}
                        <p class="trabalho-excerpt">{{ post.data.description }}</p>
                        {% endif %}
                    </div>
                </li>
                {% endfor %}
            </ul>
        </section>
    </main>

    <footer>
        <p>&copy; 2026 {{ site.author | default('Seu Nome') }}. Todos os direitos reservados.</p>
    </footer>

    <script>
        // Controle do slider
        const sliderMain = document.getElementById('sliderMain');
        const sliderGallery = document.getElementById('sliderGallery');
        const sliderIndicators = document.getElementById('sliderIndicators');
        const prevBtn = document.getElementById('prevBtn');
        const nextBtn = document.getElementById('nextBtn');

        if (sliderMain) {
            let currentIndex = 0;
            const images = sliderMain.querySelectorAll('.slider-image');
            const thumbnails = sliderGallery ? sliderGallery.querySelectorAll('.gallery-thumbnail') : [];
            const indicators = sliderIndicators ? sliderIndicators.querySelectorAll('.indicator') : [];
            const totalImages = images.length;

            function showImage(index) {
                // Garante que o índice está dentro do intervalo
                if (index < 0) index = totalImages - 1;
                if (index >= totalImages) index = 0;
                currentIndex = index;

                // Atualizar imagens
                images.forEach((img, i) => {
                    img.classList.toggle('active', i === currentIndex);
                });

                // Atualizar thumbnails
                thumbnails.forEach((thumb, i) => {
                    thumb.classList.toggle('active', i === currentIndex);
                });

                // Atualizar indicadores
                indicators.forEach((ind, i) => {
                    ind.classList.toggle('active', i === currentIndex);
                });
            }

            // Eventos dos botões de navegação
            if (prevBtn) {
                prevBtn.addEventListener('click', () => showImage(currentIndex - 1));
            }
            if (nextBtn) {
                nextBtn.addEventListener('click', () => showImage(currentIndex + 1));
            }

            // Eventos dos thumbnails
            thumbnails.forEach((thumbnail, index) => {
                thumbnail.addEventListener('click', () => showImage(index));
            });

            // Eventos dos indicadores
            indicators.forEach((indicator, index) => {
                indicator.addEventListener('click', () => showImage(index));
            });

            // Navegação com teclado
            document.addEventListener('keydown', (e) => {
                if (e.key === 'ArrowLeft') showImage(currentIndex - 1);
                if (e.key === 'ArrowRight') showImage(currentIndex + 1);
            });
        }
    </script>
</body>
</html>
